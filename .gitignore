node_modules
.next
.env
.env.local
.vercel

memory/*/wave.json
memory/*/.obsidian/
memory/*/vault/.obsidian/

# respaldos del instalador del runtime
*.bak

# bandeja de borrado manual (device_bash no puede borrar)
_to_delete/

# Vehiculos de publicacion (repos propios, no submodulos de ORION)
mercaplazarepo/
superarrozrepo/
estancorepo/
wrdrepo/
prommter/
cerebro/indice.json

# entrega intermedia del arquitecto: se consume con plan.mjs agregar y se descarta
**/tareas-propias.json

# config local del dispositivo (previews de Claude Code)
.claude/launch.json
.claude/settings.local.json

# Agenda y finanzas personales del dueño: repo local propio, nunca al remoto publico de ORION
agenda/

# Correos de cada empresa: el PDF lleva claves en claro, nunca al remoto publico
correos/

# Fichas de las ventanas (sesiones de la app): cuentan decisiones de clientes, del equipo y
# finanzas del dueño. El remoto de ORION es PÚBLICO: se quedan en esta máquina y llegan a la
# bóveda (local) con baul.mjs. Ver tools/ventanas.mjs.
cerebro/ventanas/

# Vistas Obsidian por proyecto (memory/<p>/vault/): las genera tools/generate-vault.mjs desde
# state.json, que es la fuente. Nadie las regenera ya al cerrar (la bóveda real es
# ORION-Vault, vía baul.mjs/export-vault.mjs), así que en git se quedaban semanas atrás
# (infrapilot 08-08, permanent 08-03) y duplicaban state.json. Se dejan de rastrear 2026-11-03.
memory/*/vault/

# Basura del Finder de macOS
.DS_Store

# Cerebro 3D es un repo propio (tiene su .git): no se mete dentro de ORION
cerebro-3d/
